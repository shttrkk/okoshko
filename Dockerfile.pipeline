# syntax=docker/dockerfile:1.7
# Build and run this separate offline pipeline image with --platform linux/amd64.
FROM python:3.12.15-slim-bookworm@sha256:6a0e06f5ba0b373d051aabd3fffb9b873f27f9a2a3a14bcbe37dee6f0e3bbc70 AS pipeline-build
ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
ARG TARGETARCH
RUN test "$TARGETARCH" = amd64 && python -m venv /venv
COPY pipeline/rebuild.lock /tmp/rebuild.lock
RUN /venv/bin/pip install --only-binary=:all: --require-hashes -r /tmp/rebuild.lock

FROM python:3.12.15-slim-bookworm@sha256:6a0e06f5ba0b373d051aabd3fffb9b873f27f9a2a3a14bcbe37dee6f0e3bbc70 AS pipeline
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PATH=/venv/bin:$PATH \
    NUMBA_CACHE_DIR=/tmp/numba XDG_CACHE_HOME=/tmp/cache HOME=/tmp PROJ_NETWORK=OFF
RUN apt-get update \
    && apt-get install --no-install-recommends -y libexpat1=2.5.0-1+deb12u5 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 --create-home pipeline \
    && mkdir -p /app/data && chown 10001:10001 /app/data
WORKDIR /app
COPY --from=pipeline-build /venv /venv
COPY backend/ backend/
COPY geo/ geo/
COPY pipeline/ pipeline/
USER 10001:10001
ENTRYPOINT ["python", "-m", "pipeline.rebuild"]
CMD ["--help"]
