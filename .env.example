# О!кно работает без ключей: `docker compose up --build` поднимает всё офлайн.
# Секретов здесь нет; значения ниже — несекретные настройки по умолчанию.

# Порт приложения и база из docker-compose.yml.
APP_PORT=8080
DB_URL=postgresql://okno:okno@db:5432/okno

# Необязательная LLM (любой OpenAI-совместимый провайдер). Включается, только
# если заданы одновременно LLM_MODE=live, LLM_MODEL и LLM_API_KEY; иначе offline.
# Для демо ключ не нужен: мы его не прикладываем, LLM по умолчанию выключена.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_MODE=offline
LLM_STRUCTURED_MODE=auto
LLM_TIMEOUT_S=12
